{
  "info": {
    "name": "home work 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "password",
      "value": "strong-password-123"
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "02 — Регистрация",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/user/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "user",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"first_name\": \"Иван\",\n  \"second_name\": \"Петров\",\n  \"birthdate\": \"1995-05-15\",\n  \"gender\": \"male\",\n  \"biography\": \"Книги и Python\",\n  \"city\": \"Москва\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"User UUID\", () => pm.expect(pm.response.json().user_id).to.match(/^[0-9a-f-]{36}$/));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"user_id\", pm.response.json().user_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 — Вход",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{user_id}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Token\", () => pm.expect(pm.response.json().token.length).to.be.at.least(43));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"token\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 — Анкета без токена",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [],
        "url": {
          "raw": "{{base_url}}/user/get/{{user_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "user",
            "get",
            "{{user_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Profile\", () => { const p = pm.response.json(); pm.expect(p.id).to.eql(pm.collectionVariables.get(\"user_id\")); pm.expect(p.first_name).to.eql(\"Иван\"); pm.expect(p.gender).to.eql(\"male\"); pm.expect(p).to.have.all.keys(\"id\", \"first_name\", \"second_name\", \"birthdate\", \"gender\", \"biography\", \"city\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 — Неверный пароль",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{user_id}}\",\n  \"password\": \"incorrect-password\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"JSON error\", () => pm.expect(pm.response.json().message).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 — Анкета не найдена",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [],
        "url": {
          "raw": "{{base_url}}/user/get/00000000-0000-0000-0000-000000000000",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "user",
            "get",
            "00000000-0000-0000-0000-000000000000"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"JSON error\", () => pm.expect(pm.response.json().message).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 — Неверный UUID",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [],
        "url": {
          "raw": "{{base_url}}/user/get/not-a-uuid",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "user",
            "get",
            "not-a-uuid"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"JSON error\", () => pm.expect(pm.response.json().message).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 — Дата в будущем",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/user/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "user",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"first_name\": \"Иван\",\n  \"second_name\": \"Петров\",\n  \"birthdate\": \"2999-01-01\",\n  \"gender\": \"male\",\n  \"biography\": \"Книги и Python\",\n  \"city\": \"Москва\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"JSON error\", () => pm.expect(pm.response.json().message).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 — Пользователь для входа не найден",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"00000000-0000-0000-0000-000000000000\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"JSON error\", () => pm.expect(pm.response.json().message).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    }
  ]
}
